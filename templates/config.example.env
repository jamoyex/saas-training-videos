# Copy to .env (project) or ~/.training-video.env. Never commit real keys.
TTS_PROVIDER=elevenlabs            # elevenlabs | openai | say
TTS_VOICE=                         # default voice id/name for `voiceover.py speak`
TTS_STABILITY=0.35
TTS_SPEED=0.95

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4         # eleven_v3 / eleven_multilingual_v2 also work (tags need v3+)

OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
TTS_INSTRUCTIONS=Friendly, clear, patient software trainer.

WHISPER_MODEL=                     # path to a whisper.cpp ggml model, e.g. ~/models/ggml-base.en.bin (alignment)
TRAINING_VIDEO_HOME=               # where browser logins live (default ~/.training-video)
